# http://EditorConfig.org
root = true

#################
# Common Settings
#################
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

#########################
# File Extension Settings
#########################

# Visual Studio Solution Files
[*.sln]
indent_style = tab

# XML Project Files
[*.{csproj,vbproj,xml,config,props,targets,nuspec,resx}]
indent_size = 2

# JSON/YAML Files
[*.{json,json5,yml,yaml}]
indent_size = 2

# Markdown Files
[*.md]
trim_trailing_whitespace = false

###########################
# .NET Language Conventions
###########################

# Modern C# settings for all .NET files
[*.{cs,csx,cake}]
# Use file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# Prefer nullability annotations
dotnet_enable_roslyn_analyzers = true
dotnet_diagnostic.CS8618.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8603.severity = warning

# Implicit and explicit types
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning

# Records and immutability
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_auto_properties = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# Use modern `foreach` style
dotnet_style_prefer_foreach_explicitly = true:warning

# Parentheses
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:suggestion

# Use expression-bodied members
csharp_style_expression_bodied_methods = true:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning

# Null checks and coalescing
dotnet_style_null_propagation = true:warning
csharp_style_conditional_delegate_call = true:warning
dotnet_style_coalesce_expression = true:warning

#############################
# Formatting Conventions
#############################

# Organize using directives
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace

# Code formatting
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_braces = false

# Wrapping and spacing
csharp_preserve_single_line_statements = false
csharp_space_around_binary_operators = before_and_after
csharp_space_after_cast = false
csharp_space_between_parentheses = expressions
csharp_space_around_declaration_statements = ignore

#########################
# .NET Naming Conventions
#########################

# Naming rules for consistency
dotnet_naming_symbols.private_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_readonly_fields.required_modifiers = readonly
dotnet_naming_rule.private_readonly_fields_must_be_camel_case.severity = warning
dotnet_naming_rule.private_readonly_fields_must_be_camel_case.symbols = private_readonly_fields
dotnet_naming_rule.private_readonly_fields_must_be_camel_case.style = camel_case

# Interfaces prefixed with 'I'
dotnet_naming_symbols.interface_types.applicable_kinds = interface
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case
dotnet_naming_style.prefix_interface_with_i.required_prefix = I
dotnet_naming_rule.interface_types_must_start_with_i.symbols = interface_types
dotnet_naming_rule.interface_types_must_start_with_i.style = prefix_interface_with_i
dotnet_naming_rule.interface_types_must_start_with_i.severity = warning
